{
  "name": "yazh-pure-life",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "npm run lint -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:verify": "npm run db:verify -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
