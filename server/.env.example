PORT=3001

# PostgreSQL connection string (create an empty database first, e.g. "yazh")
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/yazh

# Long random string used to sign admin session cookies (16+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin account created by `npm run db:seed` (only if it does not exist yet). Pick a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Image uploads: enter Cloudinary cloud name / API key / API secret in the admin under Settings.
# CLOUDINARY_URL is only an optional fallback (cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
CLOUDINARY_URL=

# Optional: key used to encrypt the saved Cloudinary secret (defaults to SESSION_SECRET).
# If you change SESSION_SECRET/ENCRYPTION_KEY later, re-enter the Cloudinary secret in Settings.
ENCRYPTION_KEY=
